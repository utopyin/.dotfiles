#!/bin/sh
set -eu

if [ -z "${SSH_AUTH_SOCK:-}" ]; then
  case "$(uname -s)" in
    Darwin)
      SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
      ;;
    Linux)
      SSH_AUTH_SOCK="$HOME/.1password/agent.sock"
      ;;
  esac
  export SSH_AUTH_SOCK
fi

key=$(ssh-add -L 2>/dev/null | head -n 1)
[ -n "$key" ]
printf 'key::%s\n' "$key"
