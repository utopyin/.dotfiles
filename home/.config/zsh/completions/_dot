#compdef dot
###-begin-dot-completions-###
#
# Static completion script for Zsh
#
# Installation:
#   dot --completions zsh > ~/.zsh/completions/_dot
#   then add ~/.zsh/completions to your fpath
#

_dot() {
  local context state state_descr line
  typeset -A opt_args

  local -a commands
  commands=(
    'doctor:Check dotfiles, tools, symlinks, and secret hygiene'
    'init:Bootstrap this machine'
    'update:Pull dotfiles, update packages, apply config'
    'apply:Apply home/ config links into $HOME'
    'unapply:Remove home/ config links from $HOME'
    'link:Install dot command into ~/.local/bin'
    'edit:Open the dotfiles repo or a tracked path in $VISUAL/$EDITOR'
    'unlink:Remove ~/.local/bin/dot'
    'package:Package helpers'
    'cursor:Manage the sanitized Cursor profile'
    'pi:Manage vendored Pi packages'
    'completions:Install shell completions generated by other CLIs'
    'secrets:Manage local development secrets'
  )

  local -a specs
  specs=(
    '1:command:->command'
    '*::arg:->args'
  )

  _arguments -C "${specs[@]}"

  case "$state" in
    command)
      _describe -t commands 'commands' commands
      ;;
    args)
      case "$words[1]" in
        doctor)
          _dot_doctor
          ;;
        init)
          _dot_init
          ;;
        update)
          _dot_update
          ;;
        apply)
          _dot_apply
          ;;
        unapply)
          _dot_unapply
          ;;
        link)
          _dot_link
          ;;
        edit)
          _dot_edit
          ;;
        unlink)
          _dot_unlink
          ;;
        package)
          _dot_package
          ;;
        cursor)
          _dot_cursor
          ;;
        pi)
          _dot_pi
          ;;
        completions)
          _dot_completions
          ;;
        secrets)
          _dot_secrets
          ;;
      esac
      ;;
  esac
}

_dot_doctor() {
}

_dot_init() {
}

_dot_update() {
}

_dot_apply() {
  local -a specs
  specs=(
    '(--cursor --no-cursor)--cursor[Apply the sanitized Cursor profile without prompting]'
    '(--cursor --no-cursor)--no-cursor[Disable cursor]'
    '(--no-cursor-extensions --no-no-cursor-extensions)--no-cursor-extensions[With --cursor, skip Cursor extension installs]'
    '(--no-cursor-extensions --no-no-cursor-extensions)--no-no-cursor-extensions[Disable no-cursor-extensions]'
    '(--yes --no-yes)--yes[Use defaults for prompts (does not apply Cursor)]'
    '(--yes --no-yes)--no-yes[Disable yes]'
  )
  _arguments "${specs[@]}"
}

_dot_unapply() {
}

_dot_link() {
}

_dot_edit() {
  local -a specs
  specs=(
    ':TARGET:_files'
  )
  _arguments "${specs[@]}"
}

_dot_unlink() {
}

_dot_package() {
  local context state state_descr line
  typeset -A opt_args

  local -a commands
  commands=(
    'add:Add a package to the package manifest'
    'remove:Remove a package from the package manifest'
    'update:Update installed packages from the manifest'
    'list:'
  )

  local -a specs
  specs=(
    '1:command:->command'
    '*::arg:->args'
  )

  _arguments -C "${specs[@]}"

  case "$state" in
    command)
      _describe -t commands 'commands' commands
      ;;
    args)
      case "$words[1]" in
        add)
          _dot_package_add
          ;;
        remove)
          _dot_package_remove
          ;;
        update)
          _dot_package_update
          ;;
        list)
          _dot_package_list
          ;;
      esac
      ;;
  esac
}

_dot_package_add() {
  local -a specs
  specs=(
    '(--id)--id[Mac App Store id, required for --kind mas]:integer:'
    '(--kind)--kind[Package manifest entry kind]:value:(brew cask mas tap)'
    ':NAME:'
  )
  _arguments "${specs[@]}"
}

_dot_package_remove() {
  local -a specs
  specs=(
    '(--kind)--kind[Package manifest entry kind]:value:(brew cask mas tap)'
    ':NAME:'
  )
  _arguments "${specs[@]}"
}

_dot_package_update() {
}

_dot_package_list() {
}

