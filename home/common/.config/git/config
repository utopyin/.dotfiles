[include]
	path = ~/.config/git/identity.config

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[core]
	editor = zed --wait
	excludesFile = ~/.gitignore_global
	pager = delta
	ignoreCase = false

[gpg]
	format = ssh
[commit]
	gpgSign = true

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	dark = true

[merge]
	conflictStyle = zdiff3

[alias]
	find = !git log --color -p -S

[diff]
	algorithm = histogram
	indentHeuristic = true
	colorMoved = zebra

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true
[user]
	signingKey = ~/.ssh/git-signing
[gpg "ssh"]
	program = ~/.local/bin/git-ssh-sign-file
	allowedSignersFile = ~/.ssh/allowed_signers
