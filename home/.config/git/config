[user]
	name = utopy

[core]
	editor = cursor --wait
	excludesFile = ~/.gitignore_global
	pager = delta
	ignoreCase = false

[gpg]
	format = ssh

[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign

[commit]
	gpgSign = true

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	dark = true

[merge]
	conflictStyle = zdiff3

[alias]
	find = !git log --color -p -S

[diff]
	algorithm = histogram
	indentHeuristic = true
	colorMoved = zebra

[init]
	defaultBranch = main
