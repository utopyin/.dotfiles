	"settings": "{\"settings\":\"{\\n\\t\\\"biome.requireConfiguration\\\": true,\\n\\t\\\"biome.enabled\\\": true,\\n\\t\\\"css.lint.unknownAtRules\\\": \\\"ignore\\\",\\n\\t\\\"editor.accessibilitySupport\\\": \\\"off\\\",\\n\\t\\\"[python]\\\": {\\n\\t\\t\\\"editor.defaultFormatter\\\": \\\"charliermarsh.ruff\\\",\\n\\t\\t\\\"editor.formatOnSave\\\": true,\\n\\t\\t\\\"editor.codeActionsOnSave\\\": {\\n\\t\\t\\t\\\"source.fixAll.ruff\\\": \\\"explicit\\\",\\n\\t\\t\\t\\\"source.organizeImports.ruff\\\": \\\"explicit\\\"\\n\\t\\t},\\n\\t\\t\\\"editor.rulers\\\": [88]\\n\\t},\\n\\t\\\"ruff.lineLength\\\": 88,\\n\\t\\\"editor.fontWeight\\\": \\\"400\\\",\\n\\t\\\"editor.minimap.enabled\\\": false,\\n\\t\\\"explorer.confirmDelete\\\": false,\\n\\t\\\"explorer.confirmDragAndDrop\\\": false,\\n\\t\\\"files.associations\\\": {\\n\\t\\t\\\"*.tsx\\\": \\\"typescriptreact\\\"\\n\\t},\\n\\t\\\"notebook.defaultFormatter\\\": \\\"charliermarsh.ruff\\\",\\n\\t\\\"files.exclude\\\": {\\n\\t\\t\\\"\\\": true,\\n\\t\\t\\\".git\\\": true,\\n\\t\\t\\\"**/.git\\\": false,\\n\\t\\t\\\"**/.svn\\\": false\\n\\t},\\n\\t\\\"files.watcherExclude\\\": {\\n\\t\\t\\\"**/*{rc,rc.js,rc.ts}\\\": true\\n\\t},\\n\\t\\\"git.openRepositoryInParentFolders\\\": \\\"never\\\",\\n\\t\\\"javascript.updateImportsOnFileMove.enabled\\\": \\\"always\\\",\\n\\t\\\"search.exclude\\\": {\\n\\t\\t\\\"\\\": true,\\n\\t\\t\\\"next-env.d.ts\\\": true\\n\\t},\\n\\t\\\"tailwindCSS.emmetCompletions\\\": true,\\n\\t\\\"terminal.integrated.env.osx\\\": {\\n\\t\\t\\\"FIG_NEW_SESSION\\\": \\\"1\\\",\\n\\t\\t\\\"CW_NEW_SESSION\\\": \\\"1\\\",\\n\\t\\t\\\"Q_NEW_SESSION\\\": \\\"1\\\"\\n\\t},\\n\\t\\\"terminal.integrated.tabs.defaultIcon\\\": \\\"gist-new\\\",\\n\\t\\\"typescript.updateImportsOnFileMove.enabled\\\": \\\"always\\\",\\n\\t\\\"editor.smoothScrolling\\\": true,\\n\\t\\\"explorer.compactFolders\\\": false,\\n\\t\\\"editor.fontSize\\\": 14,\\n\\t\\\"files.autoSave\\\": \\\"afterDelay\\\",\\n\\t\\\"workbench.statusBar.visible\\\": false,\\n\\t\\\"workbench.activityBar.location\\\": \\\"bottom\\\",\\n\\t\\\"diffEditor.ignoreTrimWhitespace\\\": true,\\n\\t\\\"cursor.cpp.disabledLanguages\\\": [\\\"plaintext\\\", \\\"markdown\\\", \\\"scminput\\\"],\\n\\t\\\"coderabbit.autoReviewMode\\\": \\\"disabled\\\",\\n\\t\\\"git.confirmSync\\\": false,\\n\\t\\\"git.enableSmartCommit\\\": true,\\n\\t\\\"editor.codeActionsOnSave\\\": {\\n\\t\\t\\\"source.fixAll.biome\\\": \\\"explicit\\\",\\n\\t\\t\\\"source.organizeImports.biome\\\": \\\"explicit\\\"\\n\\t},\\n\\t\\\"zig.zls.enabled\\\": \\\"on\\\",\\n\\t\\\"zig.path\\\": \\\"zig\\\",\\n\\t\\\"editor.inlayHints.enabled\\\": \\\"off\\\",\\n\\t\\\"flow-icons.hidesExplorerArrows\\\": true,\\n\\t\\\"git.blame.editorDecoration.enabled\\\": true,\\n\\t\\\"git.blame.statusBarItem.enabled\\\": true,\\n\\t\\\"diffviewer.outputFormat\\\": \\\"side-by-side\\\",\\n\\t\\\"[dockercompose]\\\": {\\n\\t\\t\\\"editor.insertSpaces\\\": true,\\n\\t\\t\\\"editor.tabSize\\\": 2,\\n\\t\\t\\\"editor.autoIndent\\\": \\\"advanced\\\",\\n\\t\\t\\\"editor.defaultFormatter\\\": \\\"redhat.vscode-yaml\\\"\\n\\t},\\n\\t\\\"[github-actions-workflow]\\\": {\\n\\t\\t\\\"editor.defaultFormatter\\\": \\\"redhat.vscode-yaml\\\"\\n\\t},\\n\\t\\\"editor.wordBasedSuggestions\\\": \\\"off\\\",\\n\\t\\\"git.showCursorWorktrees\\\": true,\\n\\t\\\"json.schemaDownload.enable\\\": true,\\n\\t\\\"tailwindCSS.classFunctions\\\": [\\n\\t\\t\\\"tv\\\",\\n\\t\\t\\\"cn\\\"\\n\\t],\\n\\t\\\"oxc.fixKind\\\": \\\"safe_fix_or_suggestion\\\",\\n\\t\\\"oxc.requireConfig\\\": true,\\n\\t\\\"oxc.unusedDisableDirectives\\\": \\\"warn\\\",\\n\\t\\\"workbench.iconTheme\\\": \\\"flow-deep\\\",\\n\\t\\\"githubPullRequests.fileListLayout\\\": \\\"tree\\\",\\n\\t\\\"tailwindCSS.lint.suggestCanonicalClasses\\\": \\\"ignore\\\",\\n\\t\\\"editor.unicodeHighlight.ambiguousCharacters\\\": false,\\n\\t\\\"diffEditor.renderSideBySide\\\": true,\\n\\t\\\"editor.defaultFormatter\\\": \\\"biomejs.biome\\\",\\n\\t\\\"editor.formatOnSave\\\": true,\\n\\t\\\"auto-chat-blocker.enable\\\": true,\\n\\t\\\"window.autoDetectColorScheme\\\": false,\\n\\t\\\"gitlens.currentLine.enabled\\\": false,\\n\\t\\\"workbench.editorAssociations\\\": {\\n\\t\\t\\\"git-rebase-todo\\\": \\\"default\\\"\\n\\t},\\n\\t\\\"typescript.experimental.useTsgo\\\": false,\\n\\t\\\"workbench.agentsWindowButton.enabled\\\": false,\\n\\t\\\"diffEditor.experimental.showMoves\\\": true,\\n\\t\\\"remote.autoForwardPortsSource\\\": \\\"hybrid\\\",\\n\\t\\\"zenMode.fullScreen\\\": false,\\n}\\n\"}"
