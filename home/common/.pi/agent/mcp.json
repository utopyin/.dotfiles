{
  "mcpServers": {
    "computer": {
      "command": "open-computer-use",
      "args": ["mcp"],
      "timeout": 60,
      "exposure": "codemode"
    },
    "axiom": {
      "url": "https://mcp.axiom.co/mcp",
      "exposure": "codemode"
    },
    "inbox-admin": {
      "url": "https://admin.inboxapp.com/api/mcp",
      "oauth": {
        "scope": "openid"
      },
      "exposure": "codemode"
    },
    "trigger": {
      "command": "npx",
      "args": ["trigger.dev@latest", "mcp"],
      "exposure": "codemode"
    },
    "PlanetScale": {
      "url": "https://mcp.pscale.dev/mcp/planetscale",
      "exposure": "codemode"
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp",
      "exposure": "codemode"
    },
    "fastmail": {
      "url": "https://api.fastmail.com/mcp",
      "exposure": "codemode"
    },
    "grafana": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GRAFANA_URL",
        "-e",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN",
        "mcp/grafana",
        "-t",
        "stdio"
      ],
      "env": {
        "GRAFANA_URL": "https://grafana.inboxapp.com",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_SERVICE_ACCOUNT_TOKEN}"
      },
      "exposure": "codemode"
    },
    "firecrawl": {
      "url": "https://mcp.firecrawl.dev/v2/mcp",
      "headers": {
        "Authorization": "Bearer ${FIRECRAWL_API_KEY}"
      },
      "exposure": "codemode"
    }
  }
}
