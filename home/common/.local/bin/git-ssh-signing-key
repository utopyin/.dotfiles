#!/bin/sh
set -eu

key_path="$HOME/.ssh/github-utopyin.pub"

if [ ! -r "$key_path" ]; then
  printf '%s\n' "git-ssh-signing-key: missing $key_path" >&2
  exit 1
fi

key=$(cat "$key_path")
case "$key" in
  ssh-* | ecdsa-* | sk-*) ;;
  *)
    printf '%s\n' "git-ssh-signing-key: invalid public key in $key_path" >&2
    exit 1
    ;;
esac

printf 'key::%s\n' "$key"
