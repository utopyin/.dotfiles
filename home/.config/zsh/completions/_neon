#compdef neon

# yargs command completion script for neon.
_neon_yargs_completions() {
  local reply
  local si=$IFS

  IFS=$'\n' reply=($(COMP_CWORD="$((CURRENT - 1))" COMP_LINE="$BUFFER" COMP_POINT="$CURSOR" neon --get-yargs-completions "${words[@]}"))
  IFS=$si

  _describe 'values' reply
}

_neon_yargs_completions "$@"
