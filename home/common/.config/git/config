[include]
	path = ~/.config/git/identity.config

[core]
	editor = zed --wait
	excludesFile = ~/.gitignore_global
	pager = delta
	ignoreCase = false

[gpg]
	format = ssh

[gpg "ssh"]
	program = op-ssh-sign
	defaultKeyCommand = git-ssh-signing-key

[commit]
	gpgSign = true

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	dark = true

[merge]
	conflictStyle = zdiff3

[alias]
	find = !git log --color -p -S

[diff]
	algorithm = histogram
	indentHeuristic = true
	colorMoved = zebra

[init]
	defaultBranch = main
