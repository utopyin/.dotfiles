{
  "lastChangelogVersion": "0.80.3",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.5",
  "defaultThinkingLevel": "medium",
  "shellCommandPrefix": "for config_file in \"$HOME\"/.config/zsh/conf.d/{20-paths,30-aliases}.zsh; do [ -r \"$config_file\" ] && . \"$config_file\"; done",
  "treeFilterMode": "no-tools",
  "terminal": {
    "showImages": true
  },
  "enableSkillCommands": true,
  "showHardwareCursor": false,
  "theme": "current-ide",
  "packages": [
    "npm:@zenobius/pi-worktrees",
    {
      "source": "npm:pi-btw",
      "extensions": ["+extensions/btw.ts"]
    },
    {
      "source": "npm:@neilurk12/pi-lazygit",
      "extensions": ["+dist/index.js"]
    },
    {
      "source": "npm:@plannotator/pi-extension",
      "skills": [],
      "extensions": ["+"]
    },
    "npm:pi-subagents"
  ],
  "editorPaddingX": 3,
  "quietStartup": true,
  "steeringMode": "one-at-a-time"
}
