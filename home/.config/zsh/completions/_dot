#compdef dot
###-begin-dot-completions-###
#
# Static completion script for Zsh
#
# Installation:
#   dot --completions zsh > ~/.zsh/completions/_dot
#   then add ~/.zsh/completions to your fpath
#

_dot() {
  local context state state_descr line
  typeset -A opt_args

  local -a commands
  commands=(
    'doctor:Check dotfiles, tools, symlinks, and secret hygiene'
    'init:Bootstrap this machine'
    'update:Pull dotfiles, update packages, apply config'
    'apply:Apply home/ config links into $HOME'
    'unapply:Remove home/ config links from $HOME'
    'link:Install dot command into ~/.local/bin'
    'unlink:Remove ~/.local/bin/dot'
    'package:Package helpers'
    'completions:Install shell completions generated by other CLIs'
    'secrets:Manage local development secrets'
  )

  local -a specs
  specs=(
    '1:command:->command'
    '*::arg:->args'
  )

  _arguments -C "${specs[@]}"

  case "$state" in
    command)
      _describe -t commands 'commands' commands
      ;;
    args)
      case "$words[1]" in
        doctor)
          _dot_doctor
          ;;
        init)
          _dot_init
          ;;
        update)
          _dot_update
          ;;
        apply)
          _dot_apply
          ;;
        unapply)
          _dot_unapply
          ;;
        link)
          _dot_link
          ;;
        unlink)
          _dot_unlink
          ;;
        package)
          _dot_package
          ;;
        completions)
          _dot_completions
          ;;
        secrets)
          _dot_secrets
          ;;
      esac
      ;;
  esac
}

_dot_doctor() {
}

_dot_init() {
}

_dot_update() {
}

_dot_apply() {
}

_dot_unapply() {
}

_dot_link() {
}

_dot_unlink() {
}

_dot_package() {
  local context state state_descr line
  typeset -A opt_args

  local -a commands
  commands=(
    'list:'
  )

  local -a specs
  specs=(
    '1:command:->command'
    '*::arg:->args'
  )

  _arguments -C "${specs[@]}"

  case "$state" in
    command)
      _describe -t commands 'commands' commands
      ;;
    args)
      case "$words[1]" in
        list)
          _dot_package_list
          ;;
      esac
      ;;
  esac
}

_dot_package_list() {
}

_dot_completions() {
  local context state state_descr line
  typeset -A opt_args

  local -a commands
  commands=(
    'add:Read completion script from stdin and install it'
  )

  local -a specs
  specs=(
    '1:command:->command'
    '*::arg:->args'
  )

  _arguments -C "${specs[@]}"

  case "$state" in
    command)
      _describe -t commands 'commands' commands
      ;;
    args)
      case "$words[1]" in
        add)
          _dot_completions_add
          ;;
      esac
      ;;
  esac
}

_dot_completions_add() {
  local -a specs
  specs=(
    '(--no-apply --no-no-apply)--no-apply[Write the completion file without applying home config links]'
    '(--no-apply --no-no-apply)--no-no-apply[Disable no-apply]'
    '(--shell)--shell[Completion shell format]:value:(zsh)'
    ':COMMAND_NAME:'
  )
  _arguments "${specs[@]}"
}

_dot_secrets() {
  local context state state_descr line
  typeset -A opt_args

  local -a commands
  commands=(
    'doctor:'
    'render:'
    'add:Add/update a secret; prompts by default, or use --value-stdin'
    'remove:'
  )

  local -a specs
  specs=(
    '1:command:->command'
    '*::arg:->args'
  )

  _arguments -C "${specs[@]}"

  case "$state" in
    command)
      _describe -t commands 'commands' commands
      ;;
    args)
      case "$words[1]" in
        doctor)
          _dot_secrets_doctor
          ;;
        render)
          _dot_secrets_render
          ;;
        add)
          _dot_secrets_add
          ;;
        remove)
          _dot_secrets_remove
          ;;
      esac
      ;;
  esac
}

_dot_secrets_doctor() {
}

_dot_secrets_render() {
}

_dot_secrets_add() {
  local -a specs
  specs=(
    '(--value-stdin --no-value-stdin)--value-stdin[Read secret value from stdin instead of prompting]'
    '(--value-stdin --no-value-stdin)--no-value-stdin[Disable value-stdin]'
    ':ENV_NAME:'
  )
  _arguments "${specs[@]}"
}

_dot_secrets_remove() {
  local -a specs
  specs=(
    ':ENV_NAME:'
  )
  _arguments "${specs[@]}"
}

# Handle both direct invocation and autoload
if [[ "${zsh_eval_context[-1]}" == "loadautofunc" ]]; then
  _dot "$@"
else
  compdef _dot dot
fi
###-end-dot-completions-###
