#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
checkout_dir=$(dirname -- "$script_dir")
dotfiles_dir=${DOTFILES_DIR:-"$checkout_dir"}

is_ubuntu() {
  [ -r /etc/os-release ] && grep -Eq '^ID(_LIKE)?=.*ubuntu' /etc/os-release
}

apt_install() {
  if [ "$(id -u)" -eq 0 ]; then
    apt-get update && apt-get install --yes "$@"
  else
    sudo apt-get update && sudo apt-get install --yes "$@"
  fi
}

if ! command -v git >/dev/null 2>&1; then
  case "$(uname -s)" in
    Darwin) /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" && brew install git ;;
    Linux)
      if command -v omarchy >/dev/null 2>&1; then
        omarchy pkg add git
      elif is_ubuntu; then
        apt_install git
      else
        printf '%s\n' "git is required; install it with your system package manager" >&2
        exit 1
      fi
      ;;
  esac
fi

if ! command -v bun >/dev/null 2>&1; then
  case "$(uname -s)" in
    Darwin) brew install bun ;;
    Linux)
      if command -v omarchy >/dev/null 2>&1; then
        omarchy install dev-env bun
      else
        if is_ubuntu; then
          apt_install curl unzip
        fi
        curl -fsSL https://bun.sh/install | bash
      fi
      ;;
  esac
fi

export PATH="$HOME/.bun/bin:$PATH"
cd "$dotfiles_dir"
bun install --frozen-lockfile
exec bun run dot init "$@"
