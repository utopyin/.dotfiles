// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "vim_mode": false,
  "proxy": "",
  "diff_view_style": "split",
  "cli_default_open_behavior": "existing_window",
  "use_system_window_tabs": false,
  "active_pane_modifiers": {
    "inactive_opacity": 1.0
  },
  "zoomed_padding": true,
  "bottom_dock_layout": "contained",
  "edit_predictions": {
    "mode": "eager"
  },
  "colorize_brackets": true,
  "snippet_sort_order": "top",
  "always_treat_brackets_as_autoclosed": true,
  "use_autoclose": true,
  "context_servers": {
    "uidotsh": {
      "enabled": true,
      "url": "https://ui.sh/mcp?agent=cursor",
      "headers": {
        "Authorization": "Bearer RQacsh93nrU96IAkrLNyQtx1iQbYST0A"
      }
    },
    "linear": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.linear.app/mcp"],
      "env": {}
    }
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "agent": {
    "sidebar_side": "left",
    "default_profile": "write",
    "tool_permissions": {
      "default": "allow",
      "tools": {
        "search_web": {
          "default": "allow"
        },
        "fetch": {
          "always_allow": [
            {
              "pattern": "^https?://linear\\.app"
            }
          ]
        },
        "terminal": {
          "always_allow": [
            {
              "pattern": "^d2\\b"
            },
            {
              "pattern": "^head\\b"
            },
            {
              "pattern": "^cd\\s+inbox(\\s|$)"
            },
            {
              "pattern": "^git\\s+log(\\s|$)"
            },
            {
              "pattern": "^echo\\s+not(\\s|$)"
            },
            {
              "pattern": "^git\\s+branch(\\s|$)"
            }
          ]
        },
        "mcp:uidotsh:uidotsh_fetch": {
          "default": "allow"
        }
      }
    },
    "default_model": {
      "speed": "fast",
      "provider": "openai-subscribed",
      "model": "gpt-5.6-sol",
      "enable_thinking": true,
      "effort": "low"
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "session": {
    "trust_all_worktrees": true
  },
  "outline_panel": {
    "dock": "right",
    "indent_size": 20.0
  },
  "project_panel": {
    "hide_hidden": true,
    "dock": "left",
    "entry_spacing": "standard",
    "hide_root": true,
    "indent_size": 10.0
  },
  "tab_size": 2,
  "ui_font_weight": 400.0,
  "auto_update_extensions": {
    "flow": false
  },
  "buffer_font_size": 16.0,
  "git_panel": {
    "tree_view": true,
    "dock": "right"
  },
  "ssh_connections": [
    {
      "host": "devbox-matteo-dev",
      "args": [],
      "projects": [
        {
          "paths": ["/mnt"]
        },
        {
          "paths": ["/usr"]
        },
        {
          "paths": ["~/.zshrc"]
        }
      ]
    },
    {
      "host": "mc-hetzner",
      "args": [],
      "projects": [
        {
          "paths": ["/"]
        },
        {
          "paths": ["/root"]
        }
      ]
    }
  ],
  "agent_servers": {
    "cursor": {
      "default_config_options": {
        "model": "claude-fable-5"
      },
      "type": "registry"
    },
    "opencode": {
      "type": "registry"
    },
    "pi-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    }
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Base Charmed Icons",
    "dark": "Base Charmed Icons"
  },
  "base_keymap": "Cursor",
  "buffer_font_features": {
    "calt": false,
    "liga": false
  },
  "terminal": {
    "font_features": {
      "calt": false,
      "liga": false
    }
  },
  "ui_font_features": {
    "calt": false,
    "liga": false
  },
  "ui_font_size": 16.0,
  "ui_font_family": ".SystemUIFont",
  "buffer_font_family": "GeistMono Nerd Font Mono",
  "theme": {
    "mode": "dark",
    "light": "GitHub Light",
    "dark": "Min Dark (Solid)"
  },
  "centered_layout": {
    "left_padding": 0.1,
    "right_padding": 0.1
  },
  "theme_overrides": {
    "Cursor Dark": {
      "text": "#D6D6DE"
    }
  },
  "hidden_files": [],
  "lsp_results_location": "picker"
}
