#!/bin/sh
set -eu

agent_socket=
case "$(uname -s)" in
  Darwin)
    agent_socket="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
    ;;
  Linux)
    agent_socket="$HOME/.1password/agent.sock"
    ;;
esac

if [ -S "$agent_socket" ]; then
  SSH_AUTH_SOCK="$agent_socket"
  export SSH_AUTH_SOCK
fi

key=$(ssh-add -L 2>/dev/null | awk '/^(ssh-|ecdsa-|sk-)/ { print; exit }')
if [ -z "$key" ]; then
  printf '%s\n' "git-ssh-signing-key: SSH agent has no valid public keys" >&2
  exit 1
fi

printf 'key::%s\n' "$key"
