_dot_completions() {
  local context state state_descr line
  typeset -A opt_args

  local -a commands
  commands=(
    'add:Read completion script from stdin and install it'
  )

  local -a specs
  specs=(
    '1:command:->command'
    '*::arg:->args'
  )

  _arguments -C "${specs[@]}"

  case "$state" in
    command)
      _describe -t commands 'commands' commands
      ;;
    args)
      case "$words[1]" in
        add)
          _dot_completions_add
          ;;
      esac
      ;;
  esac
}

_dot_completions_add() {
  local -a specs
  specs=(
    '(--no-apply --no-no-apply)--no-apply[Write the completion file without applying home config links]'
    '(--no-apply --no-no-apply)--no-no-apply[Disable no-apply]'
    '(--shell)--shell[Completion shell format]:value:(zsh)'
    ':COMMAND_NAME:'
  )
  _arguments "${specs[@]}"
}

