#!/usr/bin/env bash

set -euo pipefail

workspace="zed"
zed_class='^dev\.zed\.Zed(-Preview)?$'

zed_address() {
  hyprctl clients -j | jq -r --arg workspace "$1" --arg class "$zed_class" '
    first(
      .[]
      | select(.workspace.name == $workspace)
      | select((.class | test($class; "i")) or (.initialClass | test($class; "i")))
    ).address // empty
  '
}

# Keep an existing Zed scratchpad maximized, then show or hide it.
if address=$(zed_address "special:$workspace") && [[ -n $address ]]; then
  selector="address:$address"
  maximized=$(hyprctl clients -j | jq -r --arg address "$address" 'first(.[] | select(.address == $address)).fullscreen // 0')
  if [[ $maximized != 1 ]]; then
    hyprctl dispatch "hl.dsp.window.fullscreen({ mode = 'maximized', action = 'set', window = '$selector' })" >/dev/null
    sleep 0.1
  fi
  hyprctl dispatch "hl.dsp.workspace.toggle_special('$workspace')" >/dev/null
  exit 0
fi

# Reuse an existing Zed window. Prefer one already in the general scratchpad.
address=$(
  hyprctl clients -j | jq -r --arg class "$zed_class" '
    [
      .[]
      | select((.class | test($class; "i")) or (.initialClass | test($class; "i")))
    ]
    | sort_by(if .workspace.name == "special:scratchpad" then 0 else 1 end)
    | first.address // empty
  '
)

# Launch Zed if it is not running, then wait for its window.
if [[ -z $address ]]; then
  uwsm-app -- zeditor >/dev/null 2>&1 &

  for _ in {1..100}; do
    sleep 0.1
    address=$(
      hyprctl clients -j | jq -r --arg class "$zed_class" '
        first(
          .[]
          | select((.class | test($class; "i")) or (.initialClass | test($class; "i")))
        ).address // empty
      '
    )
    [[ -n $address ]] && break
  done
fi

if [[ -z $address ]]; then
  notify-send -u critical "Zed toggle" "Could not find the Zed window"
  exit 1
fi

selector="address:$address"
hyprctl dispatch "hl.dsp.window.move({ workspace = 'special:$workspace', follow = false, window = '$selector' })" >/dev/null
hyprctl dispatch "hl.dsp.window.fullscreen({ mode = 'maximized', action = 'set', window = '$selector' })" >/dev/null
hyprctl dispatch "hl.dsp.workspace.toggle_special('$workspace')" >/dev/null
